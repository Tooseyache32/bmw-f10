# Local isolated PostgreSQL cluster; do not point migrations at an unrelated database.
DATABASE_URL=postgresql://f10_dev@127.0.0.1:55432/f10_anatomy
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Set to the actual origin when publishing behind HTTPS. No wildcard/CORS origins.
APP_ORIGIN=http://localhost:3000
# Test suite only accepts a dedicated database whose name ends with _test.
TEST_DATABASE_URL=postgresql://f10_dev@127.0.0.1:55432/f10_anatomy_test
# Temporary credentials only for npm run db:admin. Never publish real passwords.
# ADMIN_EMAIL=admin@example.test
# ADMIN_PASSWORD=choose-at-least-12-characters
